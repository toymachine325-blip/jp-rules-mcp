# -------------------------------------------------------------
# Japan Inbound & Cross-Border Rules MCP / AI Micro Store
# Environment Variables Example
# -------------------------------------------------------------

# Server Port
PORT=3456

# Node Environment
NODE_ENV=production

# Mode: Set 'true' to run Japan Inbound Rules MCP independently (without RockTypo exporter)
JP_RULES_ONLY=true

# Stripe Billing Configuration (Optional for free tools, required for paid checkout top-up)
# Test keys begin with sk_test_ / whsec_
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Supabase Remote State Persistence (Optional, falls back to local data/store.json)
# Zero-npm-dependency pure PostgreSQL REST API
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# SUPABASE_STORE_TABLE=ai_micro_store_state
# SUPABASE_STORE_ID=default
